# Wallet Configuration (Required)
# NOTE: Never commit actual wallet secrets to git!
# Set these environment variables on your deployment platform (e.g., Render)
WALLET_ADDRESS=0x...
SECRET_KEY=0x...

# API Keys (Optional but recommended)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model paths (relative to project root)
MODEL_DIR=Model_Training
BLACKLIST_PATH=blacklist_database.json

# API Configuration
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ALCHEMY_BASE_URL=https://eth-mainnet.g.alchemy.com/v2

# Rate limiting (requests per second)
ETHERSCAN_DELAY=0.2
ALCHEMY_DELAY=0.1

# Server Configuration
BACKEND_PORT=5000
BACKEND_HOST=localhost

